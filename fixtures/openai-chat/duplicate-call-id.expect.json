{
  "format": "openai-chat",
  "issues": [
    { "rule": "duplicate-call-id", "severity": "error", "path": "$[4].tool_calls[0]", "ids": ["call_a"] }
  ],
  "changes": [
    { "op": "drop-call", "path": "$[4].tool_calls[0]", "ids": ["call_a"] },
    { "op": "drop-orphan-result", "path": "$[5]", "ids": ["call_a"] },
    { "op": "drop-empty-message", "path": "$[4]", "ids": [] }
  ]
}
